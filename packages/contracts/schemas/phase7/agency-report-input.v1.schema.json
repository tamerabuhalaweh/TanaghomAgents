{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanaghom.test/contracts/phase7/agency-report-input.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "organization_id",
    "window_start",
    "window_end",
    "metric_codes"
  ],
  "properties": {
    "contract_version": {
      "const": "phase7.agency-report-input.v1"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "metric_codes": {
      "type": "array",
      "items": {
        "enum": [
          "drafts",
          "approved_drafts",
          "leads",
          "conversions",
          "spend",
          "revenue",
          "conversion_rate"
        ]
      },
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true
    }
  }
}
