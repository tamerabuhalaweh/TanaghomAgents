{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanaghom.test/contracts/phase7/agency-executive-report.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "mode",
    "organization_id",
    "language",
    "window_start",
    "window_end",
    "metrics",
    "data_gaps",
    "summary",
    "recommendations",
    "human_approval_granted",
    "external_action_count",
    "snapshot_hash",
    "binding_id"
  ],
  "properties": {
    "contract_version": {
      "const": "phase7.agency-executive-report.v1"
    },
    "mode": {
      "const": "simulation"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "language": {
      "enum": [
        "en",
        "ar"
      ]
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_code",
          "definition_version",
          "window_start",
          "window_end",
          "unit",
          "value",
          "currency",
          "numerator",
          "denominator",
          "evidence"
        ],
        "properties": {
          "metric_code": {
            "enum": [
              "drafts",
              "approved_drafts",
              "leads",
              "conversions",
              "spend",
              "revenue",
              "conversion_rate"
            ]
          },
          "definition_version": {
            "const": "agency.metrics.v1"
          },
          "window_start": {
            "type": "string",
            "format": "date-time"
          },
          "window_end": {
            "type": "string",
            "format": "date-time"
          },
          "unit": {
            "enum": [
              "count",
              "money",
              "ratio"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "currency": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{3}$"
          },
          "numerator": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "denominator": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "version_id",
              "content_hash"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "format": "uuid"
              },
              "version_id": {
                "type": "string",
                "format": "uuid"
              },
              "content_hash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      },
      "minItems": 0,
      "maxItems": 7
    },
    "data_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_code",
          "reason"
        ],
        "properties": {
          "metric_code": {
            "enum": [
              "drafts",
              "approved_drafts",
              "leads",
              "conversions",
              "spend",
              "revenue",
              "conversion_rate"
            ]
          },
          "reason": {
            "enum": [
              "conflicting_or_duplicate_observations",
              "incompatible_window",
              "missing_observation",
              "missing_value",
              "missing_or_zero_denominator",
              "inconsistent_ratio",
              "incompatible_metric_definition",
              "mixed_currency"
            ]
          }
        }
      },
      "minItems": 0,
      "maxItems": 7
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 0,
      "maxItems": 0
    },
    "human_approval_granted": {
      "const": false
    },
    "external_action_count": {
      "const": 0
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "binding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
