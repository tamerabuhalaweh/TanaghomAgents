{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanaghom.local/schemas/phase7/agent-runtime-plan.v1.schema.json",
  "title": "Tanaghom policy-resolved agent plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "agent_version_id",
    "agent_content_hash",
    "language",
    "intent_summary",
    "steps",
    "final_response_mode"
  ],
  "properties": {
    "contract_version": {
      "const": "phase7.agent-runtime-plan.v1"
    },
    "agent_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "language": {
      "enum": ["en", "ar"]
    },
    "intent_summary": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "skill_code",
          "operation",
          "channel",
          "consent_evidence",
          "arguments_json",
          "idempotency_key",
          "rationale"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "skill_code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,79}$"
          },
          "operation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{1,79}$"
          },
          "channel": {
            "type": ["string", "null"],
            "enum": [
              null,
              "email",
              "facebook",
              "instagram",
              "linkedin",
              "live_chat",
              "sms",
              "tiktok",
              "whatsapp",
              "x",
              "youtube"
            ]
          },
          "consent_evidence": {
            "enum": ["verified", "not_required", "missing"]
          },
          "arguments_json": {
            "type": "string",
            "minLength": 2,
            "maxLength": 20000
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{7,199}$"
          },
          "rationale": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        }
      }
    },
    "final_response_mode": {
      "enum": ["result_summary", "human_escalation", "refusal"]
    }
  }
}
