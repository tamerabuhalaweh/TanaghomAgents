{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanaghom.test/contracts/creative/motion-document.v1.schema.json",
  "title": "Creative motion document v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "kind", "locale", "direction", "design_template_id", "design_version", "fps", "scenes", "elements"],
  "properties": {
    "contract_version": { "const": "creative.motion-document.v1" },
    "kind": { "const": "motion" },
    "locale": { "enum": ["ar", "en"] },
    "direction": { "enum": ["rtl", "ltr"] },
    "design_template_id": { "type": "string", "format": "uuid" },
    "design_version": { "type": "integer", "minimum": 1 },
    "design_page_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "fps": { "type": "integer", "enum": [24, 30] },
    "canvas": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "enum": [1080] },
        "height": { "type": "integer", "enum": [1080, 1350, 1920] }
      }
    },
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "page_id", "duration_ms"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "page_id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "duration_ms": { "type": "integer", "minimum": 500, "maximum": 10000 },
          "transition": {
            "type": "object", "additionalProperties": false,
            "required": ["preset"],
            "properties": {
              "preset": { "enum": ["none", "fade", "slide", "scale"] },
              "direction": { "enum": ["up", "down", "start", "end"] },
              "duration_ms": { "type": "integer", "minimum": 200, "maximum": 2000 }
            }
          }
        }
      }
    },
    "elements": {
      "type": "array", "minItems": 1, "maxItems": 48,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["node_id", "preset"],
        "properties": {
          "node_id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "scene_id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "preset": { "enum": ["none", "fade", "slide", "scale", "reveal"] },
          "direction": { "enum": ["up", "down", "start", "end"] },
          "delay_ms": { "type": "integer", "minimum": 0, "maximum": 30000 },
          "duration_ms": { "type": "integer", "minimum": 200, "maximum": 10000 },
          "easing": { "enum": ["linear", "ease", "ease-in", "ease-out", "ease-in-out"] }
        }
      }
    },
    "captions": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text", "start_ms", "end_ms"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 280 },
          "start_ms": { "type": "integer", "minimum": 0, "maximum": 30000 },
          "end_ms": { "type": "integer", "minimum": 1, "maximum": 30000 }
        }
      }
    }
  }
}
