{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanaghom.test/contracts/creative/create-job-request.v1.schema.json",
  "title": "Creative create-job request v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "capability", "lane", "params", "idempotency_key", "correlation_id"],
  "properties": {
    "contract_version": { "const": "creative.create-job-request.v1" },
    "capability": { "enum": ["image", "edit", "product_shoot", "design", "carousel", "motion", "video", "talking_head", "voice", "music", "landing_page"] },
    "lane": { "enum": ["cpu", "gpu_image", "gpu_video", "gpu_audio"] },
    "params": { "type": "object", "minProperties": 1, "maxProperties": 64 },
    "idempotency_key": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100, "default": 0 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 },
    "template_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 300 },
    "brand_kit_version_id": { "type": ["string", "null"], "format": "uuid" },
    "estimated_credits": { "type": ["integer", "null"], "minimum": 0 }
  }
}
