{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanaghom.test/contracts/creative/carousel-document.v1.schema.json",
  "title": "Creative carousel document v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "kind", "locale", "direction", "canvas", "pages"],
  "properties": {
    "contract_version": { "const": "creative.carousel-document.v1" },
    "kind": { "const": "carousel" },
    "locale": { "enum": ["ar", "en"] },
    "direction": { "enum": ["rtl", "ltr"] },
    "canvas": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "enum": [1080] },
        "height": { "type": "integer", "enum": [1080, 1350, 1920] }
      }
    },
    "brand_kit_version_id": { "type": ["string", "null"], "format": "uuid" },
    "background": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "image_version_id": { "type": "string", "format": "uuid" }
      }
    },
    "pages": {
      "type": "array", "minItems": 2, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "nodes"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "kind": { "enum": ["cover", "body", "end"] },
          "nodes": {
            "type": "array", "minItems": 1, "maxItems": 24,
            "items": { "$ref": "#/$defs/node" }
          }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "x", "y", "width", "height"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": { "enum": ["text", "image", "shape", "badge"] },
        "x": { "type": "integer", "minimum": 0, "maximum": 1080 },
        "y": { "type": "integer", "minimum": 0, "maximum": 1920 },
        "width": { "type": "integer", "minimum": 8, "maximum": 1080 },
        "height": { "type": "integer", "minimum": 8, "maximum": 1920 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "role": { "enum": ["headline", "body", "cta", "price", "caption", "logo", "product", "background", "decoration"] },
        "font_size": { "type": "integer", "minimum": 10, "maximum": 220 },
        "font_weight": { "type": "integer", "enum": [400, 500, 600, 700, 800] },
        "align": { "enum": ["start", "end", "center"] },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "background_color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "asset_version_id": { "type": "string", "format": "uuid" },
        "corner_radius": { "type": "integer", "minimum": 0, "maximum": 540 }
      }
    }
  }
}
