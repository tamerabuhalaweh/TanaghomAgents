{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanaghom.test/contracts/creative/worker-completion.v1.schema.json",
  "title": "Creative worker completion payload v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "job_id", "worker", "asset_version_id"],
  "properties": {
    "contract_version": { "const": "creative.worker-completion.v1" },
    "job_id": { "type": "string", "format": "uuid" },
    "worker": { "type": "string", "minLength": 1, "maxLength": 200 },
    "asset_version_id": { "type": "string", "format": "uuid" },
    "actual_credits": { "type": ["integer", "null"], "minimum": 0 }
  }
}
