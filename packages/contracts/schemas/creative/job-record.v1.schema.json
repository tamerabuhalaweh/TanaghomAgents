{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanaghom.test/contracts/creative/job-record.v1.schema.json",
  "title": "Creative job record v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "job_id", "organization_id", "capability", "lane", "status", "attempt", "max_attempts", "correlation_id", "idempotency_key"],
  "properties": {
    "contract_version": { "const": "creative.job-record.v1" },
    "job_id": { "type": "string", "format": "uuid" },
    "organization_id": { "type": "string", "format": "uuid" },
    "capability": { "enum": ["image", "edit", "product_shoot", "design", "carousel", "motion", "video", "talking_head", "voice", "music", "landing_page"] },
    "lane": { "enum": ["cpu", "gpu_image", "gpu_video", "gpu_audio"] },
    "status": { "enum": ["queued", "claimed", "running", "succeeded", "failed", "cancelled", "expired"] },
    "attempt": { "type": "integer", "minimum": 0 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "correlation_id": { "type": "string", "format": "uuid" },
    "idempotency_key": { "type": "string", "format": "uuid" },
    "cancel_requested": { "type": "boolean" },
    "error_class": { "type": ["string", "null"], "enum": ["transient", "deterministic", "capacity", "cancelled", "policy", "indeterminate", null] },
    "output_asset_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } }
  }
}
