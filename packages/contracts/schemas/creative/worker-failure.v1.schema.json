{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanaghom.test/contracts/creative/worker-failure.v1.schema.json",
  "title": "Creative worker failure payload v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "job_id", "worker", "error_class", "error_message"],
  "properties": {
    "contract_version": { "const": "creative.worker-failure.v1" },
    "job_id": { "type": "string", "format": "uuid" },
    "worker": { "type": "string", "minLength": 1, "maxLength": 200 },
    "error_class": { "enum": ["transient", "deterministic", "capacity", "cancelled", "policy", "indeterminate"] },
    "error_message": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "retry_after_seconds": { "type": "integer", "minimum": 0, "maximum": 86400, "default": 60 }
  }
}
