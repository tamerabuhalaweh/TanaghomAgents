# Postiz runtime environment for the Tanaghom Phase 1 host (#265).
#
# Copy to `postiz.env` next to compose.yml, set mode 0600, and never commit it.
# `deployment/postiz/postiz.env` is git-ignored.
#
#   cp deployment/postiz/postiz.env.example deployment/postiz/postiz.env
#   chmod 0600 deployment/postiz/postiz.env
#
# compose.yml sets DATABASE_URL, REDIS_URL and TEMPORAL_ADDRESS itself, pointing
# at the private postiz-internal bridge. No database password is used there: the
# Postiz database trusts its network peers and publishes no host port.

# Signs Postiz session JWTs. Generate once per host and keep it stable, otherwise
# every existing Postiz session is invalidated:
#
#   openssl rand -hex 32
JWT_SECRET=

# Optional: absolute origin Postiz uses for links and callbacks. Defaults to the
# loopback UI origin http://127.0.0.1:5000, which is what the SSH tunnel serves.
# POSTIZ_PUBLIC_URL=http://127.0.0.1:5000
