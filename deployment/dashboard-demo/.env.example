# Host configuration for the Tanaghom Phase 1 production stack (#265).
#
# Copy this file to `.env` beside compose.yml, set mode 0600, and edit only what
# this host needs. `.env` is git-ignored and must never be committed.
#
#   cp deployment/dashboard-demo/.env.example deployment/dashboard-demo/.env
#   chmod 0600 deployment/dashboard-demo/.env
#
# compose.yml defaults every switch below to its inert value, so a key that is
# missing does not fail loudly: the feature is silently off. deploy.sh,
# demo-backup.sh, demo-upgrade.sh, demo-restore.sh and workspace-control.sh all
# pass this file with `--env-file` when it exists.

# Start the model worker (compose profile "workspace") and let the dashboard
# offer the Agency workspace. The worker container must also be running; see the
# runbook section "Workspace worker lifecycle".
AGENCY_WORKSPACE_ENABLED=true

# AES-256-GCM key that encrypts stored provider credentials, base64 of exactly
# 32 random bytes. Generate it once per host and keep it:
#
#   openssl rand -base64 32
#
# Losing or replacing this value makes every already-saved provider credential
# undecryptable, and the integration must be saved and tested again.
INTEGRATION_CREDENTIAL_KEY=

# Credential key generation counter. Raise it only together with a deliberate
# re-encryption; stored rows are bound to the version that wrote them.
INTEGRATION_CREDENTIAL_KEY_VERSION=1

# Provider base URLs are https-only except for exact entries listed here. The
# co-located Postiz API is reachable only on the private compose network, so its
# internal http origin is listed explicitly. Space or comma separated.
POSTIZ_ALLOWED_BASE_URLS=http://postiz:5000/api/public/v1

# Queue approved content as Postiz drafts. Draft-only: the dashboard never
# publishes, and a human completes the publish in the Postiz UI.
POSTIZ_HANDOFF_ENABLED=true

# --- Public HTTPS (compose profile "https") -------------------------------
# Caddy terminates TLS for these hostnames and is the only public listener.
# Point both A records at the host and open inbound 80/443 in the AWS security
# group before enabling the profile. A missing or placeholder domain refuses to
# start instead of serving plain HTTP.
TANAGHOM_PUBLIC_DOMAIN=
TANAGHOM_POSTIZ_DOMAIN=
TANAGHOM_ACME_EMAIL=
# Must be the public origin once Caddy is live so session cookies become Secure.
TANAGHOM_DEMO_BASE_URL=

# --- Sessions and sign-in limits ------------------------------------------
# Access token lifetime in seconds (browser refreshes it automatically).
AUTH_ACCESS_TTL_SECONDS=900
# A browser that does not refresh for this long loses the session.
AUTH_IDLE_TTL_SECONDS=1800
# Hard ceiling for one session regardless of activity (12 hours).
AUTH_ABSOLUTE_TTL_SECONDS=43200
# Failed sign-ins allowed per 15 minutes.
AUTH_LOGIN_EMAIL_LIMIT=5
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_PAIR_LIMIT=8

# Keep automatic Postiz draft mode unavailable. `false` is the reviewed Phase 1
# value; scheduling and publishing stay human decisions.
POSTIZ_AUTOMATION_RUNTIME_READY=false

# Postiz performance sync is off for Phase 1. Leave at `false` until analytics
# acceptance exists.
POSTIZ_PERFORMANCE_SYNC_ENABLED=false
