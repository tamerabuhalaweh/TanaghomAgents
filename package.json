{
  "name": "tanaghom-agents",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "fast-uri": "3.1.6",
    "postcss": "$postcss",
    "sharp": "$sharp"
  },
  "description": "Autonomous content-to-sales operations platform with human approval gates",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/verify-repository.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.mjs migrate",
    "db:rollback": "node --env-file-if-exists=.env scripts/database.mjs rollback",
    "db:inspect:readonly": "node --env-file-if-exists=.env scripts/database-inspect-readonly.mjs",
    "dev:dashboard": "node scripts/dashboard.mjs dev",
    "build:dashboard": "node scripts/dashboard.mjs build",
    "start:dashboard": "node scripts/dashboard.mjs start",
    "typecheck:dashboard": "npm run typecheck --workspace @tanaghom/dashboard",
    "test": "node --test tests/*.test.mjs",
    "test:database": "node scripts/database-test.mjs",
    "test:dashboard-api": "node scripts/dashboard-api-integration.mjs",
    "generate:phase3-workflows": "node scripts/generate-phase3-workflows.mjs",
    "test:phase3-workflows": "node scripts/n8n-workflow-integration.mjs",
    "generate:phase4-workflows": "node scripts/generate-phase4-workflows.mjs",
    "test:phase4-workflows": "node scripts/n8n-postiz-workflow-integration.mjs",
    "generate:phase5-workflows": "node scripts/generate-phase5-workflows.mjs",
    "test:phase5-workflows": "node scripts/n8n-ghl-workflow-integration.mjs",
    "test:phase5-conversation-workflow": "node scripts/conversation-intelligence-workflow-integration.mjs",
    "test:phase5-inbound": "node scripts/ghl-inbound-gateway-integration.mjs",
    "test:phase5-intelligence": "node scripts/conversation-intelligence-evaluation.mjs",
    "test:phase5-capacity": "node scripts/conversation-capacity-integration.mjs",
    "test:phase5-resilience": "node scripts/conversation-resilience-integration.mjs",
    "test:phase5-runtime-recovery": "node scripts/n8n-runtime-recovery-integration.mjs",
    "test:phase5-retention": "node scripts/n8n-retention-pruning-integration.mjs",
    "test:phase5-dependency-loss": "node scripts/n8n-dependency-loss-integration.mjs",
    "generate:phase5g-workflows": "node scripts/generate-phase5g-workflows.mjs",
    "test:phase5g-quality": "node scripts/quality-shadow-workflow-integration.mjs",
    "test:phase6-agentic": "node scripts/phase6-agentic-simulation.mjs",
    "test:skill-registry": "node scripts/validate-skill-registry.mjs",
    "generate:phase7d-workflows": "node scripts/generate-phase7d-workflows.mjs",
    "generate:phase7d-executors": "node scripts/generate-phase7d-executor-workflows.mjs",
    "test:phase7d-executor-import": "node scripts/phase7d-executor-n8n-import-integration.mjs",
    "test:phase7d-certification": "node scripts/phase7d-runtime-certification-integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "next": "16.2.11",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
